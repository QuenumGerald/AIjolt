DRY_RUN=true
DATABASE_PATH=./data/aijolt.db
LOG_LEVEL=info
COLLECT_INTERVAL_MINUTES=60
PUBLISH_INTERVAL_MINUTES=180
REQUESTS_PER_SECOND=2
HTTP_CONCURRENCY=3
MAX_POSTS_PER_DAY_X=2
MAX_POSTS_PER_DAY_LINKEDIN=2
BUFFER_QUEUE_RESERVE=2
# Comma-separated public board identifiers (not secrets)
GREENHOUSE_BOARDS=
LEVER_SITES=
ASHBY_BOARDS=
# Buffer's current API credentials/IDs. Leave blank to use the outbox fallback.
BUFFER_ACCESS_TOKEN=
BUFFER_X_CHANNEL_ID=
BUFFER_LINKEDIN_CHANNEL_ID=
BUFFER_API_BASE_URL=
# Optional discovery command provided by your installed blazerjobs npm package.
BLAZERJOBS_COMMAND=npx blazerjobs
# Optional proxy used only for an explicitly added browser fallback.
HTTPS_PROXY=
CAPSOLVER_API_KEY=
