DRY_RUN=true
DATABASE_PATH=./data/aijolt.db
LOG_LEVEL=info
COLLECT_INTERVAL_MINUTES=60
PUBLISH_INTERVAL_MINUTES=180
REQUESTS_PER_SECOND=2
HTTP_CONCURRENCY=3
MAX_POSTS_PER_DAY_X=2
MAX_POSTS_PER_DAY_LINKEDIN=2
BUFFER_QUEUE_RESERVE=2
BUFFER_QUEUE_CAPACITY=10
# Fixed public ATS boards are optional; Foorilla discovery is enabled by default.
GREENHOUSE_BOARDS=
LEVER_SITES=
ASHBY_BOARDS=
FOORILLA_ENABLED=true
FOORILLA_PAGES=8
FOORILLA_BASE_URL=https://foorilla.com
# Foorilla topic "Data, AI, and Machine Learning" (native topic id 101).
FOORILLA_TOPICS=101
# Foorilla applique nativement les régions Europe et North America avant la collecte.
# Optional comma-separated country allowlist; leave empty for the Europe/North America default.
ALLOWED_COUNTRIES=
# Buffer credentials/IDs. Required for automatic publication.
BUFFER_ACCESS_TOKEN=
BUFFER_X_CHANNEL_ID=
BUFFER_LINKEDIN_CHANNEL_ID=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Separate, sourced AI-news satire pipeline for X. Enable only after reviewing a dry run.
AI_NEWS_ENABLED=false
AI_NEWS_GOOGLE_ENABLED=true
AI_NEWS_HN_ENABLED=true
AI_NEWS_QUERIES=OpenAI OR ChatGPT,Anthropic OR Claude,Google Gemini AI,AI model safety,AI model escaped sandbox
AI_NEWS_MAX_AGE_HOURS=36
AI_NEWS_MIN_BUZZ_SCORE=35
MAX_AI_NEWS_POSTS_PER_DAY_X=4
AI_NEWS_COLLECT_INTERVAL_MINUTES=30
AI_NEWS_PUBLISH_INTERVAL_MINUTES=120
AI_NEWS_INCLUDE_SOURCE_URL=false
# Optional overrides. Defaults accept established publications and official AI-lab domains only.
AI_NEWS_ALLOWED_PUBLISHERS=
AI_NEWS_ALLOWED_DOMAINS=
BLAZERJOBS_COMMAND=npx blazerjobs
HTTPS_PROXY=
CAPSOLVER_API_KEY=
