DRY_RUN=true
DATABASE_PATH=./data/aijolt.db
LOG_LEVEL=info
COLLECT_INTERVAL_MINUTES=60
PUBLISH_INTERVAL_MINUTES=180
REQUESTS_PER_SECOND=2
HTTP_CONCURRENCY=3
MAX_POSTS_PER_DAY_X=2
MAX_POSTS_PER_DAY_LINKEDIN=2
BUFFER_QUEUE_RESERVE=2
BUFFER_QUEUE_CAPACITY=10
# Ancien pipeline offres: désactivé par défaut. Les données existantes sont conservées.
JOBS_PIPELINE_ENABLED=false
GREENHOUSE_BOARDS=
LEVER_SITES=
ASHBY_BOARDS=
FOORILLA_ENABLED=false
FOORILLA_PAGES=8
FOORILLA_BASE_URL=https://foorilla.com
FOORILLA_TOPICS=101
ALLOWED_COUNTRIES=
# Buffer: token existant réutilisé. Destinations story = TikTok / Instagram / YouTube.
# Pas d'OAuth YouTube/TikTok/Instagram direct. Buffer n'accepte pas d'upload de fichier:
# il faut une URL HTTPS publique et stable (voir STORY_MEDIA_PUBLIC_BASE_URL).
BUFFER_ACCESS_TOKEN=
BUFFER_X_CHANNEL_ID=
BUFFER_LINKEDIN_CHANNEL_ID=
BUFFER_TIKTOK_CHANNEL_ID=
BUFFER_INSTAGRAM_CHANNEL_ID=
BUFFER_YOUTUBE_CHANNEL_ID=
BUFFER_YOUTUBE_CATEGORY_ID=24
BUFFER_YOUTUBE_PRIVACY=public
# Client LLM du script (DeepSeek déjà utilisé par le projet).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Tarifs LLM: laisser vide si inconnus. Une exécution live budgétée refusera de démarrer.
DEEPSEEK_USD_PER_1K_INPUT_TOKENS=
DEEPSEEK_USD_PER_1K_OUTPUT_TOKENS=
# Pipeline actualité IA: désactivé par défaut.
AI_NEWS_ENABLED=false
AI_NEWS_GOOGLE_ENABLED=true
AI_NEWS_HN_ENABLED=true
AI_NEWS_QUERIES=OpenAI OR ChatGPT,Anthropic OR Claude,Google Gemini AI,AI model safety,AI model escaped sandbox
AI_NEWS_MAX_AGE_HOURS=36
AI_NEWS_MIN_BUZZ_SCORE=35
MAX_AI_NEWS_POSTS_PER_DAY_X=8
AI_NEWS_MAX_LENGTH=180
AI_NEWS_COLLECT_INTERVAL_MINUTES=30
AI_NEWS_PUBLISH_INTERVAL_MINUTES=120
AI_NEWS_INCLUDE_SOURCE_URL=false
AI_NEWS_ALLOWED_PUBLISHERS=
AI_NEWS_ALLOWED_DOMAINS=
BLAZERJOBS_COMMAND=npx blazerjobs
HTTPS_PROXY=
CAPSOLVER_API_KEY=

# --- Épisodes 3D (shorts = épisodes verticaux 9:16) ---
GMI_API_KEY=
GMI_API_BASE_URL=https://console.gmicloud.ai
GMI_ORG_ID=
# Identifiants documentés: https://docs.gmicloud.ai/model-quickstarts/video/seedance-2-5-260628
GMI_VIDEO_MODEL=seedance-2-5-260628
# Identifiants documentés: https://docs.gmicloud.ai/model-quickstarts/audio/minimax-tts-speech-2-8-hd
GMI_TTS_MODEL=minimax-tts-speech-2.8-hd
# Voix TTS configurée. Ne lance pas de clonage sans échantillons. Modèle clone documenté:
# minimax-audio-voice-clone-speech-2.8-hd (manuel, hors pipeline automatique).
GMI_TTS_VOICE_ID=
GMI_TTS_LANGUAGE_BOOST=French
GMI_TTS_FORMAT=mp3
GMI_POLL_INTERVAL_MS=5000
GMI_POLL_TIMEOUT_MS=900000
GMI_VIDEO_CONCURRENCY=1
# Tarif Seedance 2.5 non publié dans les docs (contrairement à 2.0). Obligatoire pour un run live budgété.
GMI_VIDEO_USD_PER_SECOND_720P=
# Tarif TTS documenté: 0.10 USD / 1000 caractères.
GMI_TTS_USD_PER_1K_CHARS=0.10

STORY_ASSETS_DIR=./data/episodes
STORY_CHARACTER_CONFIG=./config/character.json
STORY_CHARACTER_NAME=
STORY_CHARACTER_DESCRIPTION=
STORY_CHARACTER_OUTFIT=
STORY_STYLE_DESCRIPTION=animation 3D stylisée, rendu cinématique propre, éclairage doux
STORY_CHARACTER_REFERENCE_URLS=
STORY_CHARACTER_REFERENCE_VIDEO_URLS=
STORY_AVATAR_ASSET_IDS=
STORY_RATIO=9:16
STORY_RESOLUTION=720p
STORY_WIDTH=720
STORY_HEIGHT=1280
STORY_FPS=30
STORY_SEGMENT_MAX_SECONDS=15
STORY_SEGMENT_MIN_SECONDS=4
STORY_DURATION_MAX_DRIFT_SECONDS=30
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_CONCURRENCY=1
FFMPEG_THREADS=2
STORY_MAX_ATTEMPTS=3
STORY_BUDGET_EPISODE_USD=20
STORY_BUDGET_GLOBAL_USD=80
STORY_BUDGET_PERIOD_DAYS=30
STORY_BUDGET_ALLOW_UNKNOWN=false
# URL HTTPS publique et stable du dossier des MP4, sans authentification. Buffer fetch au moment de la publication.
STORY_MEDIA_PUBLIC_BASE_URL=
# Sinon, hébergement via l'API d'upload GMI documentée (POST .../upload-url, file_type=mp4).
STORY_HOST_VIA_GMI_UPLOAD=true
STORY_BUFFER_DESTINATIONS=tiktok,instagram,youtube
STORY_TTS_MAX_CHARS=5000
