---
import Layout from '../../layouts/Layout.astro'; import { articles } from '../../data';
const types=[...new Set(articles.map(a=>a.type))];
---
<Layout title="AI career insights — AIJolt"><main><header><p>AIJOLT INSIGHTS</p><h1>Read the AI job market.</h1></header><form><input id="search" type="search" placeholder="Search insights" aria-label="Search articles"/><select id="type"><option value="">All types</option>{types.map(type=><option value={type}>{type.replaceAll('_',' ')}</option>)}</select></form><section>{articles.map(a=><article data-type={a.type} data-search={`${a.title} ${a.excerpt}`.toLowerCase()}><small>{a.type.replaceAll('_',' ')} · {a.publishedAt&&new Date(a.publishedAt).toLocaleDateString('en')}</small><h2><a href={`/articles/${a.slug}`}>{a.title}</a></h2><p>{a.excerpt}</p></article>)}</section></main></Layout>
<script>const search=document.querySelector<HTMLInputElement>('#search')!,type=document.querySelector<HTMLSelectElement>('#type')!,items=[...document.querySelectorAll<HTMLElement>('article')]; const filter=()=>items.forEach(item=>item.hidden=!(item.dataset.search?.includes(search.value.toLowerCase())&&(!type.value||item.dataset.type===type.value))); search.addEventListener('input',filter);type.addEventListener('change',filter);</script>
<style>main{max-width:850px;margin:auto;padding:50px 24px 100px;font-family:system-ui;color:#171717}header{padding:50px 0}header p,small{color:#e6502f;font:700 11px monospace}h1{font:700 clamp(48px,8vw,82px)/1 Georgia}form{display:flex;gap:10px;padding:20px 0;border-bottom:1px solid #ddd}input,select{padding:12px;border:1px solid #ccc;background:white}input{flex:1}article{padding:32px 0;border-bottom:1px solid #ddd}h2{font:700 32px Georgia;margin:12px 0}a{color:inherit;text-decoration:none}p{color:#5b5a55;line-height:1.6}</style>
