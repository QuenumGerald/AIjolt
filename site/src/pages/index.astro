---
import Layout from '../layouts/Layout.astro';
import { generatedAt, jobs } from '../data';
import { itemListJsonLd, jobPath, SITE_NAME } from '../lib/seo';

const formatDate = (date: string | null) =>
  date ? new Intl.DateTimeFormat('fr-FR', { dateStyle: 'medium' }).format(new Date(date)) : null;

const title = `${SITE_NAME} — Offres d’emploi IA publiées`;
const description = jobs.length
  ? `${jobs.length} offres IA réellement postées par AIJolt sur X / Buffer. Mis à jour ${generatedAt ? formatDate(generatedAt) : 'récemment'}.`
  : 'AIJolt publie des offres IA sur X / Buffer. Les annonces apparaîtront ici dès qu’elles sont postées — pas un scrape brut.';
---
<Layout title={title} description={description} canonicalPath="/" jsonLd={itemListJsonLd(jobs)}>
  <div class="page">
    <section class="hero" aria-label="AIJolt">
      <div class="hero-wash" aria-hidden="true">
        <div class="orb orb-a"></div>
        <div class="orb orb-b"></div>
        <div class="grain"></div>
      </div>

      <div class="hero-copy">
        <p class="brand">AIJolt</p>
        <h1>Le board des annonces qu’on assume.</h1>
        <p class="lede">
          Uniquement les offres déjà mises en file ou publiées via Buffer / X — une URL stable, rien de scrapé pour faire volume.
        </p>
        <div class="cta-row">
          <a class="cta" href="#annonces">{jobs.length ? 'Parcourir les annonces' : 'Voir l’état du feed'}</a>
          <p class="cta-note">
            {jobs.length
              ? `${jobs.length} publiée${jobs.length > 1 ? 's' : ''}${generatedAt && formatDate(generatedAt) ? ` · maj ${formatDate(generatedAt)}` : ''}`
              : 'Aucune publication indexable pour l’instant'}
          </p>
        </div>
      </div>
    </section>

    <section id="annonces" class="board">
      <header class="board-head">
        <h2>Annonces postées</h2>
        <p>Lecture linéaire. Pas de tableau de bord.</p>
      </header>

      {jobs.length > 0 ? (
        <ul class="listing" aria-label="Annonces IA publiées">
          {jobs.map((job, index) => (
            <li style={`--i:${index}`}>
              <a class="row" href={jobPath(job)}>
                <div class="row-main">
                  <span class="row-title">{job.title}</span>
                  <span class="row-company">{job.company}</span>
                </div>
                <div class="row-meta">
                  <span>{job.workMode === 'unknown' ? 'IA' : job.workMode}</span>
                  <span>{job.location}</span>
                  <span>{formatDate(job.socialPublishedAt ?? job.postedAt) ?? '—'}</span>
                </div>
                <span class="row-go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty" role="status">
          <p class="empty-kicker">Feed public</p>
          <h3>Encore silencieux.</h3>
          <p>
            AIJolt n’expose que ce qui a été réellement posté. Quand le gateway marque une offre
            <code>queued</code> ou <code>published</code>, elle apparaît ici avec sa page
            <code>/jobs/…</code>.
          </p>
          <p class="empty-hint">Pas de remplissage cosmétique depuis Foorilla.</p>
        </div>
      )}
    </section>

    <footer class="foot">
      <span class="brand-mini">AIJolt</span>
      <span>Annonces postées · indexables.</span>
    </footer>
  </div>
</Layout>

<style>
  .page {
    width: min(1080px, calc(100% - 40px));
    margin: 0 auto;
    padding-bottom: 80px;
  }

  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(90vh, 820px);
    display: flex;
    align-items: flex-end;
    margin-inline: calc(50% - 50vw);
    width: 100vw;
    padding: 56px max(20px, calc(50vw - 540px)) 68px;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .hero-wash {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(40px);
    animation: drift 14s ease-in-out infinite;
  }

  .orb-a {
    width: min(70vw, 640px);
    height: min(70vw, 640px);
    right: -8%;
    top: -18%;
    background: radial-gradient(circle at 40% 40%, rgba(47, 111, 106, 0.55), transparent 68%);
  }

  .orb-b {
    width: min(55vw, 480px);
    height: min(55vw, 480px);
    left: -12%;
    bottom: -20%;
    background: radial-gradient(circle at 50% 50%, rgba(196, 92, 74, 0.28), transparent 70%);
    animation-delay: -4s;
  }

  .grain {
    position: absolute;
    inset: 0;
    opacity: 0.18;
    background:
      linear-gradient(115deg, transparent 40%, rgba(255, 255, 255, 0.35) 50%, transparent 60%),
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 3px,
        rgba(10, 21, 32, 0.03) 3px,
        rgba(10, 21, 32, 0.03) 4px
      );
  }

  .hero-copy {
    max-width: 38rem;
    animation: rise 0.9s var(--ease) both;
  }

  .brand {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3.8rem, 11vw, 7.2rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
    color: var(--ink);
    animation: ink-in 1s var(--ease) both;
  }

  h1 {
    margin: 26px 0 14px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.35rem, 2.5vw, 1.85rem);
    line-height: 1.25;
    letter-spacing: -0.03em;
    max-width: 16ch;
    color: var(--ink-mid);
  }

  .lede {
    margin: 0;
    color: var(--slate);
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 36ch;
    font-weight: 500;
  }

  .cta-row {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 20px;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 50px;
    padding: 0 22px;
    background: var(--ink);
    color: #f4f1ec;
    text-decoration: none;
    font-weight: 700;
    letter-spacing: -0.01em;
    border: 1px solid transparent;
    transition: transform 0.25s var(--ease), background 0.2s, color 0.2s;
  }

  .cta:hover {
    background: var(--copper);
    color: #fff;
    transform: translateY(-2px);
  }

  .cta-note {
    margin: 0;
    color: var(--slate);
    font-size: 0.92rem;
    font-weight: 600;
  }

  .board {
    padding: 58px 0 20px;
  }

  .board-head {
    margin-bottom: 26px;
  }

  .board-head h2 {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.45rem, 2.6vw, 1.9rem);
    letter-spacing: -0.03em;
  }

  .board-head p {
    margin: 0;
    color: var(--slate);
    font-weight: 500;
  }

  .listing {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .listing > li {
    border-bottom: 1px solid var(--line);
    animation: rise 0.55s var(--ease) both;
    animation-delay: calc(var(--i) * 0.05s);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr) auto;
    gap: 14px 22px;
    align-items: center;
    padding: 24px 2px;
    text-decoration: none;
    transition: padding-left 0.25s var(--ease), background 0.2s;
  }

  .row:hover {
    padding-left: 12px;
    background: rgba(255, 255, 255, 0.28);
  }

  .row-main {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .row-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.12rem;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  .row-company {
    color: var(--slate);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .row-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    color: var(--slate);
    font-size: 0.86rem;
    font-weight: 500;
  }

  .row-go {
    color: var(--copper);
    font-size: 1.2rem;
    transition: transform 0.25s var(--ease);
  }

  .row:hover .row-go {
    transform: translateX(5px);
  }

  .empty {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 48px 4px 52px;
    max-width: 38rem;
    animation: rise 0.7s var(--ease) both;
  }

  .empty-kicker {
    margin: 0 0 10px;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sea);
  }

  .empty h3 {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.03em;
  }

  .empty p {
    margin: 0 0 12px;
    color: var(--slate);
    line-height: 1.65;
    font-weight: 500;
  }

  .empty code {
    font-family: var(--font-body);
    font-size: 0.92em;
    background: rgba(10, 21, 32, 0.06);
    padding: 0.08em 0.32em;
  }

  .empty-hint {
    margin-top: 16px !important;
    color: var(--ink-mid) !important;
    font-weight: 700 !important;
  }

  .foot {
    margin-top: 52px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    align-items: baseline;
    color: var(--slate);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .brand-mini {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  @media (max-width: 820px) {
    .hero {
      min-height: min(86vh, 700px);
      padding-bottom: 48px;
    }
    .row {
      grid-template-columns: 1fr auto;
    }
    .row-meta {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .page {
      width: calc(100% - 28px);
    }
    .brand {
      font-size: clamp(3.2rem, 17vw, 4.4rem);
    }
  }
</style>
