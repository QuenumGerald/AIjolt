---
import Layout from '../../layouts/Layout.astro';
import { jobs } from '../../data';
import {
  jobCanonical,
  jobMetaDescription,
  jobPath,
  jobPostingJsonLd,
  jobSlug,
  jobTitleTag,
} from '../../lib/seo';

export function getStaticPaths() {
  return jobs.map((job) => ({
    params: { slug: jobSlug(job) },
    props: { job },
  }));
}

const { job } = Astro.props;

const formatDate = (date: string | null) =>
  date ? new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long' }).format(new Date(date)) : null;

const postedLabel = formatDate(job.socialPublishedAt ?? job.postedAt);
const title = jobTitleTag(job);
const description = jobMetaDescription(job);
const path = jobPath(job);
---
<Layout
  title={title}
  description={description}
  canonicalPath={path}
  ogType="article"
  jsonLd={jobPostingJsonLd(job)}
>
  <main class="shell">
    <nav class="crumb"><a href="/">← Toutes les annonces</a></nav>
    <article class="offer">
      <p class="brand">AIJolt</p>
      <p class="eyebrow">
        {(job.networks ?? []).join(' · ') || 'publié'}
        {postedLabel ? ` · ${postedLabel}` : ''}
      </p>
      <h1>{job.title}</h1>
      <p class="company">{job.company}</p>
      <ul class="facts">
        <li><span>Lieu</span> {job.location}{job.country !== 'Unknown' ? ` (${job.country})` : ''}</li>
        <li><span>Mode</span> {job.workMode === 'unknown' ? 'Non précisé' : job.workMode}</li>
        {job.salary && <li><span>Salaire</span> {job.salary}</li>}
        {job.skills?.length > 0 && (
          <li><span>Compétences</span> {job.skills.slice(0, 12).join(', ')}</li>
        )}
      </ul>
      <div class="body">
        <h2>Description</h2>
        <p>{job.description}</p>
      </div>
      {job.socialText && (
        <aside class="social">
          <h2>Tel que posté</h2>
          <pre>{job.socialText}</pre>
        </aside>
      )}
      <p class="cta">
        <a class="apply" href={job.url} target="_blank" rel="noopener noreferrer">Postuler sur le site de l’employeur ↗</a>
      </p>
      <p class="canonical-note">Page canonique : <a href={jobCanonical(job)}>{jobCanonical(job)}</a></p>
    </article>
  </main>
</Layout>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) {
    margin: 0;
    background:
      radial-gradient(1000px 520px at 0% -20%, #dfe8ff 0%, transparent 55%),
      #f6f7f9;
    color: #12141a;
    font-family: "IBM Plex Sans", "Segoe UI", sans-serif;
  }
  .shell { max-width: 760px; margin: auto; padding: 28px 24px 80px; }
  .crumb { margin-bottom: 28px; }
  .crumb a { color: #0f766e; text-decoration: none; font-weight: 650; font-size: 14px; }
  .brand {
    margin: 0 0 8px;
    font: 700 42px/1 "Fraunces", Georgia, serif;
    letter-spacing: -0.04em;
  }
  .eyebrow {
    margin: 0;
    color: #0f766e;
    font: 650 12px/1.4 "IBM Plex Mono", ui-monospace, monospace;
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  h1 {
    font: 650 clamp(28px, 5vw, 44px)/1.15 "Fraunces", Georgia, serif;
    margin: 14px 0 10px;
    letter-spacing: -0.03em;
  }
  .company { font-size: 18px; font-weight: 650; margin: 0 0 22px; }
  .facts {
    list-style: none; padding: 18px 0; margin: 0 0 28px;
    border-top: 1px solid #d8dee8; border-bottom: 1px solid #d8dee8;
  }
  .facts li { margin: 10px 0; color: #334155; line-height: 1.45; }
  .facts span {
    display: inline-block; min-width: 110px; color: #64748b; font-size: 13px; font-weight: 650;
  }
  .body h2, .social h2 {
    font: 650 20px "Fraunces", Georgia, serif; margin: 0 0 12px;
  }
  .body p {
    white-space: pre-wrap; color: #334155; line-height: 1.65; font-size: 15px; margin: 0;
  }
  .social {
    margin-top: 32px; padding: 18px; background: rgba(255,255,255,0.75);
    border: 1px solid #d9e0ea;
  }
  .social pre {
    margin: 0; white-space: pre-wrap; font: 14px/1.5 "IBM Plex Sans", sans-serif; color: #1e293b;
  }
  .cta { margin-top: 36px; }
  .apply {
    display: inline-flex; align-items: center; gap: 8px;
    background: #0f172a; color: #f8fafc; text-decoration: none;
    font-weight: 650; padding: 14px 18px;
  }
  .apply:hover { background: #0f766e; }
  .canonical-note { margin-top: 28px; font-size: 12px; color: #94a3b8; }
  .canonical-note a { color: #64748b; }
  @media (max-width: 600px) {
    .shell { padding-inline: 18px; }
    .facts span { display: block; margin-bottom: 2px; }
  }
</style>
