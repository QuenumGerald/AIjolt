---
import Layout from '../../layouts/Layout.astro';
import { jobs } from '../../data';
import {
  jobCanonical,
  jobMetaDescription,
  jobPath,
  jobPostingJsonLd,
  jobSlug,
  jobTitleTag,
} from '../../lib/seo';

export function getStaticPaths() {
  return jobs.map((job) => ({
    params: { slug: jobSlug(job) },
    props: { job },
  }));
}

const { job } = Astro.props;

const formatDate = (date: string | null) =>
  date ? new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long' }).format(new Date(date)) : null;

const postedLabel = formatDate(job.socialPublishedAt ?? job.postedAt);
const title = jobTitleTag(job);
const description = jobMetaDescription(job);
const path = jobPath(job);
const modeLabel = job.workMode === 'unknown' ? 'Non précisé' : job.workMode;
---
<Layout
  title={title}
  description={description}
  canonicalPath={path}
  ogType="article"
  jsonLd={jobPostingJsonLd(job)}
>
  <div class="page">
    <nav class="crumb"><a href="/#annonces">← Annonces AIJolt</a></nav>

    <article class="offer">
      <p class="brand">AIJolt</p>
      <p class="posted">
        Posté{(job.networks?.length ? ` · ${job.networks.join(' · ')}` : '')}
        {postedLabel ? ` · ${postedLabel}` : ''}
      </p>
      <h1>{job.title}</h1>
      <p class="company">{job.company}</p>

      <dl class="facts">
        <div><dt>Lieu</dt><dd>{job.location}{job.country !== 'Unknown' ? ` · ${job.country}` : ''}</dd></div>
        <div><dt>Mode</dt><dd>{modeLabel}</dd></div>
        {job.salary && <div><dt>Salaire</dt><dd>{job.salary}</dd></div>}
        {job.skills?.length > 0 && (
          <div><dt>Stack</dt><dd>{job.skills.slice(0, 12).join(', ')}</dd></div>
        )}
      </dl>

      <section class="body">
        <h2>Description</h2>
        <p>{job.description}</p>
      </section>

      {job.socialText && (
        <section class="social">
          <h2>Tel que posté</h2>
          <pre>{job.socialText}</pre>
        </section>
      )}

      <p class="cta">
        <a class="apply" href={job.url} target="_blank" rel="noopener noreferrer">Postuler chez l’employeur</a>
      </p>
      <p class="canonical-note">
        Page canonique : <a href={jobCanonical(job)}>{jobCanonical(job)}</a>
      </p>
    </article>
  </div>
</Layout>

<style>
  .page {
    width: min(760px, calc(100% - 40px));
    margin: 0 auto;
    padding: 36px 0 80px;
  }

  .crumb {
    margin-bottom: 36px;
  }

  .crumb a {
    text-decoration: none;
    font-weight: 600;
    color: var(--mute);
  }

  .crumb a:hover {
    color: var(--ink);
  }

  .offer {
    animation: rise 0.7s var(--ease) both;
  }

  .brand {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.4rem, 7vw, 3.4rem);
    letter-spacing: -0.05em;
    line-height: 0.95;
  }

  .posted {
    margin: 14px 0 0;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6a8a00;
  }

  h1 {
    margin: 18px 0 10px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.7rem, 4.5vw, 2.5rem);
    letter-spacing: -0.035em;
    line-height: 1.12;
  }

  .company {
    margin: 0 0 28px;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--mute);
  }

  .facts {
    margin: 0 0 36px;
    padding: 20px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: 14px;
  }

  .facts div {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 12px;
  }

  dt {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mute);
  }

  dd {
    margin: 0;
    line-height: 1.45;
  }

  .body h2,
  .social h2 {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .body p {
    margin: 0;
    white-space: pre-wrap;
    color: var(--ink-soft);
    line-height: 1.65;
    font-size: 1rem;
  }

  .social {
    margin-top: 36px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .social pre {
    margin: 0;
    white-space: pre-wrap;
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .cta {
    margin-top: 40px;
  }

  .apply {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 22px;
    background: var(--ink);
    color: var(--jolt);
    text-decoration: none;
    font-weight: 700;
    transition: transform 0.25s var(--ease), background 0.2s;
  }

  .apply:hover {
    background: var(--ink-soft);
    transform: translateY(-2px);
  }

  .canonical-note {
    margin-top: 28px;
    font-size: 0.78rem;
    color: var(--mute);
    word-break: break-all;
  }

  .canonical-note a {
    color: var(--mute);
  }

  @media (max-width: 560px) {
    .page { width: calc(100% - 28px); }
    .facts div { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
